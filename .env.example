# Server-side environment template. Copy to .env (git-ignored) and fill in.
# Every value below is an inert placeholder: the app builds without them and shows unavailable states.

# Application database connection (pooled). Required only for database-backed
# features via server/db.ts; validated lazily on first backend access.
# Neon: use the pooled connection string for application traffic.
DATABASE_URL=

# Direct (unpooled) connection, preferred by migration tooling (drizzle-kit).
# When unset or blank, migration commands fall back to DATABASE_URL (useful
# for local/CI setups with a single connection). Never used by application
# code and never exposed to the browser.
DATABASE_DIRECT_URL=

# Local/CI test connection to an administrative Postgres for the ephemeral
# database tests (npm run test:db). Defaults to the local Docker Postgres
# documented in docs/DATABASE.md when unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:15432/postgres

# Never set NEXT_PUBLIC_* for secrets; server secrets must stay server-side.

# Leave both blank only for an unavailable-auth local preview. Never use NEXT_PUBLIC_ here.
# Copy the exact branch Auth URL from Neon Console; synthetic parent branches only.
NEON_AUTH_BASE_URL=
# Generate locally: openssl rand -base64 32 (32+ characters; never commit it).
NEON_AUTH_COOKIE_SECRET=

# Exact application origin for private draft and verification mutations (no path or trailing slash).
# Must match the browser Origin; never inferred from Host/forwarded headers.
# Local example: http://localhost:3000. Set separately per preview/production.
APP_ORIGIN=

# Default neon-http for Neon; postgres supports a standard local/self-hosted
# PostgreSQL server through the same authenticated application and SQL services.
DATABASE_TRANSPORT=neon-http
# Set demo only on the explicitly synthetic branch to display its notice.
CATALOG_MODE=production

# University mailbox verification. Required only when the verified runtime is
# configured; do not use a test transport or bypass in deployed environments.
# Generate a value with at least 32 characters and keep it unique per branch.
AFFILIATION_HMAC_SECRET=

# Resend sender credentials for an authorized, provider-verified sender.
RESEND_API_KEY=
RESEND_FROM=

# Authorizes only the internal Vercel cleanup cron. At least 32 characters; no whitespace.
# never expose it to the browser or use it as a general API credential.
CRON_SECRET=
